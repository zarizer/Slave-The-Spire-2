    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435 \u0441\u043D\u043E\u0432\u0430
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
    \u043D\u0435\u043B\u0430\u0434\u043D\u043E\u0435.\n\n\u041C\u043D\u043E\u0433\u0438\u0435
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0447\u0430\u043B\u0438
    \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0431\u0438\u043B\u0435\u0442
    \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430 \u0431\u0438\u0442\u0432\u044B
    \u0437\u0430 \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0430
    \u043A\u0430\u0447\u0430\u043B\u043A\u0438, \u0442\u0430\u043A \u043A\u0430\u043A
    \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439 \u043F\u043E\u0433\u0438\u0431.\n\n\u0412\u0430\u043C
    \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443
    \u043F\u043E\u043B\u043D\u044B\u0445 \u043E\u0442\u043C\u043E\u0440\u043E\u0437\u043A\u043E\u0432,
    \u043F\u0440\u043E\u0439\u0442\u0438 \u0441 \u043D\u0438\u043C\u0438 \u043F\u0443\u0442\u044C
    \u043E\u0442 \u041A\u043E\u043B\u0442\u0443\u0448\u0435\u0439 \u0434\u043E \u043A\u0430\u0447\u0430\u043B\u043A\u0438
    \u0432 \u041A\u0443\u043F\u0447\u0438\u043D\u043E \u0438, \u043F\u043E\u0431\u0435\u0434\u0438\u0432
    \u043C\u043D\u043E\u0433\u0438\u0445 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432,
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F, \u0447\u0442\u043E
    \u0436\u0435 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
    \u0442\u0430\u043C \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0430
    \u0442\u0430\u043A \u0436\u0435, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u0437\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u043D\u043E\u0432\u043E\u0433\u043E
    \u043C\u0430\u0441\u0442\u0435\u0440\u0430.\n "
